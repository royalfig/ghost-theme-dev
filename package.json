{
  "name": "@royalfig/gtb",
  "version": "5.0.1",
  "description": "A modern tool for developing and building Ghost themes with esbuild, Tailwind, and Live Reload",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "dev": "tsx watch src/index.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "engines": {
    "node": ">=22.22"
  },
  "bin": {
    "gtb": "dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "!src/**/__tests__",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ghost",
    "theme",
    "development",
    "build",
    "esbuild",
    "tailwind",
    "livereload"
  ],
  "author": "Ryan Feigenbaum",
  "license": "MIT",
  "dependencies": {
    "@inquirer/confirm": "6.4.0",
    "@inquirer/input": "5.2.0",
    "@inquirer/select": "5.3.0",
    "@tryghost/admin-api": "^1.14.16",
    "archiver": "8.0.0",
    "browserslist": "^4.29.5",
    "chalk": "6.0.1",
    "chokidar": "6.0.0",
    "esbuild": "0.28.2",
    "gscan": "6.7.0",
    "lightningcss": "^1.33.0",
    "open": "^11.0.4",
    "portfinder": "1.0.38",
    "sharp": "0.35.5",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "26.6.6",
    "@types/ws": "^8.18.2",
    "@vitest/ui": "^5.1.0",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/royalfig/ghost-theme-dev"
  },
  "publishConfig": {
    "access": "public"
  }
}
